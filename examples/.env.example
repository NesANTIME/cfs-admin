# ==============================================================================
# CFCS Admin Backend - Archivo de Configuración de Ejemplo (.env.example)
# ==============================================================================

RED__HOST=127.0.0.1
RED__PORT=8000
RED__TRUSTED_PROXIES=127.0.0.1


DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=postgres
DATABASE__PASSWORD=tu_password_seguro_postgres
DATABASE__DB=cfcs_db

# mostrar las consultas sql en produccion (solo desarrollo)
DATABASE__SQLECHO=false


# Puedes generar una con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT__SECRET_KEY=cambiar_por_una_clave_secreta_de_al_menos_32_caracteres_aleatorios_12345
JWT__ALGORITHM=HS256

# Duración del Access Token (en minutos)
JWT__ACCESS_TOKEN=15
# Duración del Refresh Token (en días)
JWT__REFRESH_TOKEN=7


CORS__ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
CORS__ALLOW_METHODS=["GET","POST","PATCH","DELETE","OPTIONS"]
CORS__ALLOW_HEADERS=["Content-Type","Authorization"]
CORS__ALLOW_CREDENTIALS=false



# Tiempo de expiración de las invitaciones a salas (en minutos, entre 1 y 30)
VIDEOCONFERENCIA__INVITACION=2
VIDEOCONFERENCIA__STUN_URLS=["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]



# ------------------------------------------------------------------------------
# 6. Administrador Inicial Predeterminado (Opcional)
# ------------------------------------------------------------------------------
# Contraseña para el superusuario 'admin' que se sincroniza al arrancar.
# Si no se define, se utilizará 'admincfs' por defecto en desarrollo local.
ADMIN_DEFAULT_PASSWORD=AdminSuperSeguro2026!!