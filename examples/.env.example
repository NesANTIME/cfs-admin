# Configuración del Backend
PORT_APP=8000

# Seguridad JWT (Generar con: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=tu_clave_secreta_de_al_menos_32_caracteres
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE"]
CORS_ALLOW_HEADERS=["Content-Type", "Authorization"]
CORS_ALLOW_CREDENTIALS=true

# Base de Datos PostgreSQL
POSTGRES_USER=cfs_user
POSTGRES_PASSWORD=cfs_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cfs-admin
