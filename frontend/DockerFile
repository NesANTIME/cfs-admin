FROM httpd:2.4

RUN sed -i \
    's/^#LoadModule proxy_module/LoadModule proxy_module/' \
    /usr/local/apache2/conf/httpd.conf \
    && sed -i \
    's/^#LoadModule proxy_http_module/LoadModule proxy_http_module/' \
    /usr/local/apache2/conf/httpd.conf \
    && printf '\nServerName localhost\nProxyPass /api/ http://api:8000/\nProxyPassReverse /api/ http://api:8000/\n' \
    >> /usr/local/apache2/conf/httpd.conf

COPY frontend/ /usr/local/apache2/htdocs/