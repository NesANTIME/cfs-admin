FROM httpd:2.4

RUN sed -i \
    's/^#LoadModule proxy_module/LoadModule proxy_module/' \
    /usr/local/apache2/conf/httpd.conf \
    && sed -i \
    's/^#LoadModule proxy_http_module/LoadModule proxy_http_module/' \
    /usr/local/apache2/conf/httpd.conf \
    && sed -i \
    's/^#LoadModule proxy_wstunnel_module/LoadModule proxy_wstunnel_module/' \
    /usr/local/apache2/conf/httpd.conf \
    && sed -i \
    's/^#LoadModule headers_module/LoadModule headers_module/' \
    /usr/local/apache2/conf/httpd.conf \
    && printf '%s\n' \
    '' \
    'ServerName localhost' \
    '# Reemplaza cualquier X-Forwarded-For enviado por el cliente.' \
    'RequestHeader set X-Forwarded-For "%{REMOTE_ADDR}s"' \
    'ProxyAddHeaders On' \
    '# WebSocket de videoconferencia (debe ir antes de la regla /api/).' \
    'ProxyPass /api/videoconferencia/ws/ ws://api:8000/videoconferencia/ws/' \
    'ProxyPassReverse /api/videoconferencia/ws/ ws://api:8000/videoconferencia/ws/' \
    'ProxyPass /api/ http://api:8000/' \
    'ProxyPassReverse /api/ http://api:8000/' \
    >> /usr/local/apache2/conf/httpd.conf

COPY frontend/ /usr/local/apache2/htdocs/
